# Backend environment variables for Glass
# Copy to .env and fill in values

# --- CORS ---
GLASS_ALLOW_ORIGIN=*
GLASS_ALLOW_CREDENTIALS=false
GLASS_LOG_LEVEL=INFO

# --- Providers ---
# OpenAI (LLM)
GLASS_LLM_PROVIDER=openai
GLASS_OPENAI_API_KEY=sk-...
GLASS_OPENAI_MODEL=gpt-4.1-mini
GLASS_OPENAI_ANALYSIS_MODEL=gpt-5-mini
GLASS_OPENAI_BASE_URL=https://api.openai.com/v1
GLASS_OPENAI_ROLE=progress

# ElevenLabs (TTS)
GLASS_ELEVENLABS_API_KEY=sk-...
GLASS_ELEVENLABS_MODEL=eleven_flash_v2_5
GLASS_ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
GLASS_ELEVENLABS_AI_VOICE_ID=iP95p4xoKVk53GoZ742B

# Deepgram (ASR)
GLASS_ASR_PROVIDER=deepgram
GLASS_DEEPGRAM_KEY=dg-...
GLASS_DEEPGRAM_MODEL=nova-3
GLASS_DEEPGRAM_LANGUAGE=en
GLASS_DEEPGRAM_ENCODING=linear16
GLASS_DEEPGRAM_SAMPLE_RATE=16000
GLASS_DEEPGRAM_INTERIM_RESULTS=true
GLASS_DEEPGRAM_UTTERANCE_END_MS=1500
GLASS_DEEPGRAM_ENDPOINTING_MS=1200

# --- Session/limits (tune or unset to disable where noted) ---
GLASS_TAIL_SIZE=20
# WebSocket TTL (seconds) and message size cap (bytes)
GLASS_WS_MAX_SESSION_SECONDS=120
GLASS_WS_MAX_MESSAGE_BYTES=131072