# --- CORS ---
GLASS_ALLOW_ORIGIN=*
GLASS_ALLOW_CREDENTIALS=false
GLASS_LOG_LEVEL=INFO

# --- Providers ---
# OpenAI (LLM)
GLASS_LLM_PROVIDER=openai
GLASS_OPENAI_API_KEY=sk-...
GLASS_OPENAI_MODEL=gpt-4.1-mini
GLASS_OPENAI_BASE_URL=https://api.openai.com/v1

# Gemini (LLM)
# Set GLASS_LLM_PROVIDER=gemini to use this adapter
GLASS_GEMINI_API_KEY=ai-...
GLASS_GEMINI_MODEL=gemini-2.5-flash
GLASS_GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/models

# ElevenLabs (TTS)
GLASS_TTS_PROVIDER=elevenlabs
GLASS_ELEVENLABS_API_KEY=sk-...
GLASS_ELEVENLABS_MODEL=eleven_flash_v2_5
GLASS_ELEVENLABS_VOICE_ID=cgSgspJ2msm6clMCkdW9
GLASS_ELEVENLABS_AI_VOICE_ID=iP95p4xoKVk53GoZ742B

# Deepgram (ASR)
GLASS_ASR_PROVIDER=deepgram
GLASS_DEEPGRAM_KEY=dg-...

# Zep (Memory)
GLASS_MEMORY_PROVIDER=zep
GLASS_ZEP_API_KEY=z_...

# Azure Blob Storage
GLASS_AZURE_BLOB_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devstoreaccount1;AccountKey=Eby8vdM02xNOcqFlqUwJPLlmEtlCDXJ1OUzFT50uSRZ6IFsuFq2UVErCz4I6tq/K1SZFPTOtr/KBHBeksoGMGw==;BlobEndpoint=http://azurite:10000/devstoreaccount1;
GLASS_AZURE_BLOB_CONTAINER=glass-avatars
GLASS_AZURE_BLOB_PUBLIC_BASE_URL=http://localhost:10000/devstoreaccount1/glass-avatars
GLASS_AZURE_BLOB_API_VERSION=2023-11-03
GLASS_AZURE_BLOB_PUBLIC_ACCESS=blob
# GLASS_AZURE_BLOB_SIGN_URLS=true
# GLASS_AZURE_BLOB_SIGNED_URL_TTL_SECONDS=31536000

# --- Auth ---
GLASS_AUTH_JWT_SECRET=replace-with-strong-secret

# --- Database ---
GLASS_REDIS_URL=redis://redis:6379/0
